{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/closure.png",
        "height": 12,
        "padding": {
            "top": 0,
            "left": 2,
            "right": 2,
            "bottom": 0
        }
    },
    "display": {
