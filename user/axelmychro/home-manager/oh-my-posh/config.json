{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "console_title_template": "PRTS",
    "blocks": [
        {
            "alignment": "left",
            "segments": [
                {
                    "type": "shell",
                    "style": "plain",
                    "template": "{{ .Name }} "
                },
                {
                    "type": "path",
                    "style": "plain",
                    "options": {
                        "folder_icon": "....",
                        "home_icon": "~",
                        "style": "agnoster_short"
                    },
                    "template": "{{ .Path }} "
                },
                {
                    "type": "git",
                    "style": "plain",
                    "options": {
                        "branch_icon": "\ue725 ",
                        "cherry_pick_icon": "\ue29b ",
                        "commit_icon": "\uf417 ",
                        "fetch_status": false,
                        "fetch_upstream_icon": false,
                        "merge_icon": "\ue727 ",
                        "no_commits_icon": "\uf0c3 ",
                        "rebase_icon": "\ue728 ",
                        "revert_icon": "\uf0e2 ",
                        "tag_icon": "\uf412 "
                    },
                    "template": "{{ .HEAD }} "
                },
                {
                    "type": "text",
                    "style": "plain",
                    "template": "󰜌 "
                }
            ],
            "type": "prompt"
        }
    ],
    "final_space": true
}
